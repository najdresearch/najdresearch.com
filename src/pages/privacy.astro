---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE } from "@/config";
---

<SiteLayout
  title="Privacy — Najd Research"
  description="Privacy information for the Najd Research website and correspondence."
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="page-shell header-inner">
      <a class="wordmark" href="/" aria-label="Najd Research home"
        ><img
          class="wordmark-logo"
          src="/logo.webp"
          alt=""
          width="96"
          height="49"
        /><span>Najd Research</span></a
      ><nav aria-label="Primary navigation">
        <a href="/">Home</a>
      </nav>
    </div>
  </header>
  <main id="main-content" class="document-shell page-shell">
    <header class="document-hero">
      <p class="kicker">POLICY / PRIVACY</p><h1>Privacy, kept simple.</h1><p
        class="document-lede"
      >
        This is a public research website. It has no user accounts and does not
        accept prompts, source code, or other product data.
      </p>
    </header>
    <article class="policy-copy">
      <h2>Website data</h2><p>
        Najd Research does not use advertising trackers on this site. The
        infrastructure that serves the website may process standard request
        information, such as network address, browser type, requested page, and
        time of access, as needed to operate and protect the service.
      </p>
      <h2>Correspondence</h2><p>
        If you contact Najd Research by email, we receive the address and
        information you choose to send. We use it to read and respond to your
        message and to continue a conversation you requested.
      </p>
      <h2>External links</h2><p>
        Links to GitHub, X, Hugging Face, and other external services are
        governed by those services' own privacy practices.
      </p>
      <h2>Contact</h2><p>
        Privacy questions may be sent to <a href={`mailto:${SITE.email}`}
          >{SITE.email}</a
        >.
      </p>
    </article>
  </main>
  <footer>
    <div class="page-shell document-footer">
      <p>Najd Research · Riyadh, Saudi Arabia</p><div>
        <a href="/">Home</a><a href="/security">Security</a>
      </div>
    </div>
  </footer>
</SiteLayout>
