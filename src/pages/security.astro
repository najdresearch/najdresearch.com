---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE } from "@/config";
---

<SiteLayout
  title="Security — Najd Research"
  description="Security reporting and responsible disclosure for Najd Research."
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="page-shell header-inner">
      <a class="wordmark" href="/" aria-label="Najd Research home"
        ><img
          class="wordmark-logo"
          src="/logo.webp"
          alt=""
          width="96"
          height="49"
        /><span>Najd Research</span></a
      ><nav aria-label="Primary navigation">
        <a href="/">Home</a>
      </nav>
    </div>
  </header>
  <main id="main-content" class="document-shell page-shell">
    <header class="document-hero">
      <p class="kicker">POLICY / SECURITY</p><h1>
        Report security issues privately.
      </h1><p class="document-lede">
        Please do not disclose a suspected vulnerability publicly before we have
        had time to investigate and coordinate a fix.
      </p>
    </header>
    <article class="policy-copy">
      <h2>Reporting</h2><p>
        Send a clear description, affected page or repository, reproduction
        steps, and potential impact to <a
          href={`mailto:${SITE.email}?subject=Security%20report`}
          >{SITE.email}</a
        >. Do not include credentials or unrelated personal data.
      </p>
      <h2>Safe harbor</h2><p>
        Najd Research will not pursue action against good-faith research that
        avoids privacy violations, service disruption, data destruction, and
        access beyond what is necessary to demonstrate an issue.
      </p>
      <h2>Coordination</h2><p>
        Please allow reasonable time to investigate and address a report before
        public disclosure. We will acknowledge useful reports and coordinate in
        good faith.
      </p>
    </article>
  </main>
  <footer>
    <div class="page-shell document-footer">
      <p>Najd Research · Riyadh, Saudi Arabia</p><div>
        <a href="/">Home</a><a href="/privacy">Privacy</a>
      </div>
    </div>
  </footer>
</SiteLayout>
