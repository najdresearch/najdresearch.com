---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE } from "@/config";
---

<SiteLayout
  title="Najd Code — Najd Research"
  description="A local-first environment where agents can plan, use tools, delegate work, and finish software."
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="page-shell header-inner">
      <a class="wordmark" href="/" aria-label="Najd Research home">
        <img
          class="wordmark-logo"
          src="/logo.webp"
          alt=""
          width="96"
          height="49"
        />
        <span>Najd Research</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/">Research <span>01</span></a>
        <a href={SITE.github} target="_blank" rel="noreferrer">Source ↗</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="document-shell page-shell">
    <header class="document-hero">
      <p class="kicker">01 / ACTIVE SYSTEM</p>
      <h1>Najd Code</h1>
      <p class="document-lede">
        A local-first coding environment for solo developers, built around
        inspectable agent work rather than invisible automation.
      </p>
      <span class="status" data-status="active"
        >Public preview in preparation</span
      >
    </header>

    <section class="document-grid" aria-labelledby="principles-title">
      <div>
        <p class="section-number">01 / PRODUCT</p>
        <h2 id="principles-title">
          Local when you want it. Governed when you need it.
        </h2>
      </div>
      <div class="document-copy">
        <p>
          Solo developers get local services, managed models, optional provider
          keys, durable plans, explicit approvals, tasks, checkpoints, and
          cancellable autocomplete.
        </p>
        <p>
          Enterprise deployments add self-hosted identity, policy, approvals,
          execution nodes, and metadata-only audit without centralizing source
          code or prompts.
        </p>
      </div>
    </section>

    <section class="evidence-table" aria-labelledby="release-title">
      <div class="evidence-heading">
        <p class="section-number">02 / RELEASE EVIDENCE</p>
        <h2 id="release-title">No artifact before the evidence.</h2>
      </div>
      <dl>
        <div><dt>Target</dt><dd>macOS 12+ · Apple silicon</dd></div>
        <div><dt>Distribution</dt><dd>Signed ZIP and DMG</dd></div>
        <div>
          <dt>Inference</dt><dd>Managed local models · Optional BYOK</dd>
        </div>
        <div>
          <dt>Publication gate</dt><dd>
            Notarization · Checksums · Three-pass matrix · Eight-hour soak
          </dd>
        </div>
      </dl>
    </section>

    <section class="document-callout">
      <p class="section-number">03 / AVAILABILITY</p>
      <h2>The first public build is not posted yet.</h2>
      <p>
        Source and signed downloads will appear together after the release
        evidence passes. Until then, no page or repository should be treated as
        a release.
      </p>
      <a class="document-link" href="https://github.com/najdresearch"
        >Follow the source record ↗</a
      >
    </section>
  </main>

  <footer>
    <div class="page-shell document-footer">
      <p>Najd Research · Riyadh, Saudi Arabia</p><div>
        <a href="/privacy">Privacy</a><a href="/security">Security</a>
      </div>
    </div>
  </footer>
</SiteLayout>
