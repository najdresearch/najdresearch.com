---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE } from "@/config";

const year = new Date().getFullYear();
---

<SiteLayout
  title="Najd Research — Independent research lab in Riyadh"
  description="Najd Research is an independent lab in Riyadh building open models and systems for the region and beyond."
>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <div class="page-shell header-inner">
      <a class="wordmark" href="/" aria-label="Najd Research home">
        <img
          class="wordmark-logo"
          src="/logo.webp"
          alt=""
          width="96"
          height="49"
        />
        <span>Najd Research</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#focus">Focus <span>01</span></a>
        <a href="#join">Join us <span>02</span></a>
        <a href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">Independent research lab · Riyadh</p>
        <h1 id="hero-title">
          Built here.<br /><em>Open to the world.</em>
        </h1>
        <p class="hero-intro">
          Najd Research is an independent lab in Riyadh, building open systems
          and pursuing research that can create lasting impact across the region
          and beyond.
        </p>
      </div>

      <figure class="landscape-figure">
        <div class="landscape-frame">
          <img
            src="/tuwaiq.webp"
            alt="The limestone cliffs of Jabal Tuwaiq in Najd"
            width="1800"
            height="1101"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          <span>FIG. 001 / JABAL TUWAIQ / 24.38° N · 46.17° E</span>
          <span>NAJD / RIYADH</span>
        </figcaption>
      </figure>
    </section>

    <section
      class="focus-section page-shell"
      id="focus"
      aria-labelledby="focus-title"
    >
      <p class="section-number">01 / FOCUS</p>
      <div class="focus-grid">
        <h2 id="focus-title">Build what should exist.</h2>
        <p>
          Models grounded in this region. Systems that can reason, search,
          create, and act. Research released openly so others can inspect it,
          challenge it, and build on it.
        </p>
      </div>
    </section>

    <section class="join-section" id="join" aria-labelledby="join-title">
      <div class="page-shell join-grid">
        <div>
          <p class="section-number">02 / JOIN US</p>
          <h2 id="join-title">Build it with us.</h2>
        </div>
        <div class="join-copy">
          <p>
            Najd is at the beginning. We want researchers, engineers, and
            independent builders who want to shape an institution—not just join
            one. Send us something you have built, or tell us what you believe
            should exist.
          </p>
          <div class="join-actions">
            <a
              class="primary-action"
              href={`mailto:${SITE.email}?subject=Joining%20Najd%20Research`}
              >Build with us ↗</a
            >
            <a
              class="text-action"
              href={SITE.github}
              target="_blank"
              rel="noreferrer">Follow the work ↗</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="page-shell footer-grid">
      <img class="footer-logo" src="/logo.webp" alt="" width="96" height="49" />
      <div class="footer-identity">
        <p class="footer-name">Najd Research</p>
      </div>
      <div class="footer-links">
        <a href="/privacy">Privacy</a>
        <a href="/security">Security</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href={SITE.x} target="_blank" rel="noreferrer">X ↗</a>
        <a href={SITE.huggingFace} target="_blank" rel="noreferrer"
          >Hugging Face ↗</a
        >
      </div>
      <p class="image-credit">
        Jabal Tuwaiq photograph: saudipics,
        <a
          href="https://creativecommons.org/licenses/by-sa/4.0/"
          target="_blank"
          rel="noreferrer">CC BY-SA 4.0</a
        >. Cropped and rendered in monochrome.
      </p>
      <p class="copyright">© {year} Najd Research</p>
    </div>
  </footer>
</SiteLayout>
