---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE } from "@/config";
import { foundations, products } from "@/data/research";

const year = new Date().getFullYear();
---

<SiteLayout>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="announcement" role="status">
    <div class="page-shell announcement-inner">
      <span><i aria-hidden="true"></i> Najd Code / Active development</span>
      <span>Open systems for machine intelligence</span>
    </div>
  </div>

  <header class="site-header">
    <div class="page-shell header-inner">
      <a class="wordmark" href="/" aria-label="Najd Research home">
        <img
          class="wordmark-logo"
          src="/logo.webp"
          alt=""
          width="96"
          height="49"
        />
        <span>Najd Research</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#code">Work <span>01</span></a>
        <a href="#about">Principles <span>02</span></a>
        <a href="#research">Research <span>03</span></a>
        <a href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">
          <span>01</span> Independent AI research from Riyadh
        </p>
        <h1 id="hero-title">
          Intelligence should be <em>open,</em> inspectable, and useful.
        </h1>
        <p class="hero-intro">
          Najd Research builds open systems for machine intelligence. We are
          starting with Najd Code—an environment where agents can plan, use
          tools, delegate work, and finish software.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href="#code">Explore Najd Code</a>
          <a class="text-action" href="#research">Research index ↓</a>
        </div>
      </div>

      <figure class="landscape-figure">
        <div class="landscape-frame">
          <img
            src="/tuwaiq.webp"
            alt="The limestone cliffs of Jabal Tuwaiq in Najd"
            width="1800"
            height="1101"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          <span>FIG. 001 / JABAL TUWAIQ / 24.38° N · 46.17° E</span>
          <span>NAJD / RIYADH</span>
        </figcaption>
      </figure>

      <dl class="hero-meta-grid">
        <div>
          <dt>Status</dt>
          <dd><i aria-hidden="true"></i> Active development</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Agent systems</dd>
        </div>
        <div>
          <dt>Base</dt>
          <dd>Riyadh, SA</dd>
        </div>
      </dl>
    </section>

    <section
      class="work-section page-shell"
      id="code"
      aria-labelledby="work-title"
    >
      <div class="section-heading">
        <div>
          <p class="section-number">02 / CURRENT WORK</p>
          <h2 id="work-title">
            One active edge.<br />A connected system next.
          </h2>
        </div>
        <p>
          Najd Code is the active proving ground. Chat, Craft, Search, Models,
          and Inference follow from the same open foundation as the next systems
          to build.
        </p>
      </div>

      <ol class="product-list" aria-label="Najd product roadmap">
        {
          products.map((product, index) => (
            <li class:list={["product-record", `is-${product.status}`]}>
              <div class="record-topline">
                <span class="record-number">{product.number}</span>
                {index < products.length - 1 && (
                  <span class="record-arrow" aria-hidden="true">
                    →
                  </span>
                )}
              </div>
              <div class="record-body">
                <h3>{product.name}</h3>
                <p>{product.description}</p>
              </div>
              <span class="status" data-status={product.status}>
                {product.label}
              </span>
            </li>
          ))
        }
      </ol>

      <div class="foundation-block" aria-labelledby="foundation-title">
        <div>
          <p class="section-number">SHARED FOUNDATIONS</p>
          <h3 id="foundation-title">One stack beneath the products.</h3>
        </div>
        <ol class="foundation-list">
          {
            foundations.map((foundation, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h4>{foundation.name}</h4>
                  <p>{foundation.description}</p>
                </div>
                <code>{foundation.repository}</code>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      class="principles-section"
      id="about"
      aria-labelledby="principles-title"
    >
      <div class="page-shell principles-grid">
        <div class="principles-intro">
          <p class="section-number">03 / PRINCIPLES</p>
          <h2 id="principles-title">The work should explain the lab.</h2>
          <p>
            Najd Research exists to make machine intelligence more open,
            inspectable, and dependable through systems people can actually use.
          </p>
        </div>
        <ol class="principles-list">
          <li>
            <span>01</span>
            <div>
              <h3>Open by default</h3>
              <p>
                Publish code, methods, and evidence that make scrutiny possible.
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Systems over demos</h3>
              <p>
                Build reliable environments around models, not spectacles around
                isolated outputs.
              </p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Research through building</h3>
              <p>
                Let working software reveal the questions worth answering next.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section
      class="ledger-section page-shell"
      id="research"
      aria-labelledby="ledger-title"
    >
      <div class="ledger-heading">
        <div>
          <p class="section-number">04 / RESEARCH INDEX</p>
          <h2 id="ledger-title">Evidence, when it is ready.</h2>
        </div>
        <p>
          Releases, notes, models, and experiments will appear here when there
          is something concrete to inspect.
        </p>
      </div>
      <div class="empty-ledger">
        <div>
          <span class="empty-ledger-number">000</span>
          <p>Index status</p>
        </div>
        <div>
          <h3>No public releases yet.</h3>
          <p>
            Najd Code is in active development. We will publish the record with
            the work.
          </p>
        </div>
        <span class="status" data-status="foundation">Forthcoming</span>
      </div>
    </section>
  </main>

  <footer>
    <div class="page-shell footer-grid">
      <img class="footer-logo" src="/logo.webp" alt="" width="96" height="49" />
      <div class="footer-identity">
        <p class="footer-name">Najd Research</p>
        <p>Independent AI research from Riyadh.</p>
      </div>
      <div class="footer-links">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
      <p class="image-credit">
        Jabal Tuwaiq photograph: saudipics,
        <a
          href="https://creativecommons.org/licenses/by-sa/4.0/"
          target="_blank"
          rel="noreferrer">CC BY-SA 4.0</a
        >. Cropped and rendered in monochrome.
      </p>
      <p class="copyright">© {year} Najd Research</p>
    </div>
  </footer>
</SiteLayout>
