---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { SITE } from "@/config";
import { ledger, products } from "@/data/research";

const year = new Date().getFullYear();
---

<SiteLayout>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="announcement" role="status">
    <div class="page-shell announcement-inner">
      <span><i aria-hidden="true"></i> Najd Code / Active development</span>
      <span>Open systems for machine intelligence</span>
    </div>
  </div>

  <header class="site-header">
    <div class="page-shell header-inner">
      <a class="wordmark" href="/" aria-label="Najd Research home">
        <span class="wordmark-seal" aria-hidden="true">نجد</span>
        <span>Najd Research</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#code">Code <span>01</span></a>
        <a href="#research">Research <span>02</span></a>
        <a href="#about">About <span>03</span></a>
        <a href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">
          <span>01</span> Independent AI research from Riyadh
        </p>
        <h1 id="hero-title">
          Intelligence should be <em>open,</em> inspectable, and useful.
        </h1>
        <p class="hero-intro">
          Najd Research builds open systems for machine intelligence. We are
          starting with Najd Code—an environment where agents can plan, use
          tools, delegate work, and finish software.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href="#code">See what we are building</a>
          <a class="text-action" href="#research">Read the index ↓</a>
        </div>
        <dl class="hero-meta-grid">
          <div>
            <dt>Status</dt>
            <dd><i aria-hidden="true"></i> Active development</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Agent systems</dd>
          </div>
          <div>
            <dt>Base</dt>
            <dd>Riyadh, SA</dd>
          </div>
        </dl>
      </div>

      <figure class="portrait-figure">
        <div class="portrait-frame">
          <img
            src="/portrait.webp"
            alt="Engraved profile portrait representing Najd"
            width="840"
            height="1229"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption>
          <span>FIG. 001</span>
          <span>NAJD / RIYADH</span>
        </figcaption>
      </figure>
    </section>

    <section class="statement-band" aria-label="Research position">
      <div class="page-shell statement-inner">
        <p>Najd Code <b>01</b></p>
        <span aria-hidden="true">→</span>
        <p>Najd Chat <b>02</b></p>
        <span aria-hidden="true">→</span>
        <p>Najd Search <b>03</b></p>
        <span aria-hidden="true">→</span>
        <p>Najd Models <b>04</b></p>
      </div>
    </section>

    <section
      class="work-section page-shell"
      id="code"
      aria-labelledby="work-title"
    >
      <div class="section-heading">
        <div>
          <p class="section-number">02 / CURRENT WORK</p>
          <h2 id="work-title">
            One active edge.<br />A larger system behind it.
          </h2>
        </div>
        <p>
          We are building the shared foundation through Najd Code first. Other
          products remain named commitments, not claims of availability.
        </p>
      </div>

      <ol class="product-list">
        {
          products.map(product => (
            <li class:list={["product-record", `is-${product.status}`]}>
              <span class="record-number">{product.number}</span>
              <div class="record-body">
                <h3>{product.name}</h3>
                <p>{product.description}</p>
              </div>
              <span class="status" data-status={product.status}>
                {product.label}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="principles-section"
      id="about"
      aria-labelledby="principles-title"
    >
      <div class="page-shell principles-grid">
        <div class="principles-intro">
          <p class="section-number">03 / PRINCIPLES</p>
          <h2 id="principles-title">The work should explain the lab.</h2>
          <p>
            Najd Research exists to make machine intelligence more open,
            inspectable, and dependable through systems people can actually use.
          </p>
        </div>
        <ol class="principles-list">
          <li>
            <span>01</span>
            <div>
              <h3>Open by default</h3>
              <p>
                Publish the code, methods, and evidence that make scrutiny
                possible.
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Systems over demos</h3>
              <p>
                Build reliable environments around models, not spectacles around
                isolated outputs.
              </p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Research through building</h3>
              <p>
                Let working software reveal the questions worth answering next.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section
      class="ledger-section page-shell"
      id="research"
      aria-labelledby="ledger-title"
    >
      <div class="ledger-heading">
        <div>
          <p class="section-number">04 / RESEARCH LEDGER</p>
          <h2 id="ledger-title">A record of the work.</h2>
        </div>
        <p>Releases, notes, models, and experiments will accumulate here.</p>
      </div>
      <ol class="ledger-list">
        {
          ledger.map(record => (
            <li>
              <span class="ledger-number">{record.number}</span>
              <time>{record.date}</time>
              <div class="ledger-copy">
                <h3>{record.title}</h3>
                <p>{record.description}</p>
              </div>
              <span class="status" data-status={record.status}>
                {record.label}
              </span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer>
    <div class="page-shell footer-grid">
      <div class="footer-mark" aria-hidden="true">نجد</div>
      <div>
        <p class="footer-name">Najd Research</p>
        <p>Independent AI research from Riyadh.</p>
      </div>
      <div class="footer-links">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
      <p class="copyright">© {year} Najd Research</p>
    </div>
  </footer>
</SiteLayout>
